---
import { Image } from 'astro:assets';
import { PHOTOS } from '../data/wedding';
import FloralAccent from './FloralAccent.astro';
import SectionLabel from './ornaments/SectionLabel.astro';

const [first, second, third] = PHOTOS;
---

<section class='py-20 md:py-28 px-4 sm:px-6 bg-paper-texture'>
  <div class='max-w-5xl mx-auto'>
    <div class='text-center mb-14 relative'>
      <FloralAccent position='top-center' opacity={0.4} class='top-15!' />
      <div class='flex items-center gap-3 text-gold justify-center mb-5'>
        <div class='flex-1 h-px bg-gold opacity-25 max-w-20'></div>
        <svg
          width='7'
          height='7'
          viewBox='0 0 10 10'
          fill='currentColor'
          style='opacity:0.5'
        >
          <polygon points='5,0 10,5 5,10 0,5'></polygon>
        </svg>
        <div class='w-2 h-px bg-gold opacity-35'></div>
        <svg width='11' height='11' viewBox='0 0 10 10' fill='currentColor'>
          <polygon points='5,0 10,5 5,10 0,5'></polygon>
        </svg>
        <div class='w-2 h-px bg-gold opacity-35'></div>
        <svg
          width='7'
          height='7'
          viewBox='0 0 10 10'
          fill='currentColor'
          style='opacity:0.5'
        >
          <polygon points='5,0 10,5 5,10 0,5'></polygon>
        </svg>
        <div class='flex-1 h-px bg-gold opacity-25 max-w-20'></div>
      </div>
      <SectionLabel>Nuestros momentos</SectionLabel>
    </div>

    <!-- Polaroid photo stack -->
    <div
      class='flex flex-col sm:flex-row items-center sm:items-end justify-center gap-6 sm:gap-8'
    >
      <!-- Photo 1 - rotated left -->
      <div class='polaroid' style='transform: rotate(-3deg);'>
        <div
          class='relative overflow-hidden bg-cream-dark'
          style='width: 220px; aspect-ratio: 3/4;'
        >
          <Image
            src={first.src}
            alt={first.alt}
            width={600}
            height={800}
            format='webp'
            loading='lazy'
            class='w-full h-full object-cover'
          />
        </div>
        <p class='text-center font-script text-burgundy/60 text-sm mt-2'>
          Momentos
        </p>
      </div>

      <!-- Photo 2 - centered, slightly larger -->
      <div
        class='polaroid sm:-mt-6'
        style='transform: rotate(1deg); z-index: 2;'
      >
        <div
          class='relative overflow-hidden bg-cream-dark'
          style='width: 240px; aspect-ratio: 3/4;'
        >
          <Image
            src={second.src}
            alt={second.alt}
            width={600}
            height={800}
            format='webp'
            loading='lazy'
            class='w-full h-full object-cover'
          />
        </div>
        <p class='text-center font-script text-burgundy/60 text-sm mt-2'>
          Recuerdos
        </p>
      </div>

      <!-- Photo 3 - rotated right -->
      <div class='polaroid' style='transform: rotate(-1.5deg);'>
        <div
          class='relative overflow-hidden bg-cream-dark'
          style='width: 220px; aspect-ratio: 3/4;'
        >
          <Image
            src={third.src}
            alt={third.alt}
            width={600}
            height={800}
            format='webp'
            loading='lazy'
            class='w-full h-full object-cover'
          />
        </div>
        <p class='text-center font-script text-burgundy/60 text-sm mt-2'>
          Amor
        </p>
      </div>
    </div>
  </div>
</section>
