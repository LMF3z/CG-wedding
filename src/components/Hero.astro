---
import { Image } from 'astro:assets';
import { HERO_IMAGE, WEDDING_DATE, COUPLE } from '../data/wedding';
import FloralAccent from './FloralAccent.astro';
import ThinRule from './ornaments/ThinRule.astro';
import { ChevronDownIcon } from './Icons';
---

<section
  class='relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-burgundy-texture px-6 py-20'
>
  <!-- Cream paper card centered on burgundy background -->
  <div
    class='relative w-full max-w-2xl mx-auto bg-paper-texture border border-gold/20 shadow-2xl px-6 sm:px-12 py-12 sm:py-16 z-10'
  >
    <!-- Floral accents in corners -->
    <FloralAccent position='top-left' opacity={0.5} />
    <FloralAccent position='top-right' opacity={0.5} />
    <FloralAccent position='bottom-left' opacity={0.35} />
    <FloralAccent position='bottom-right' opacity={0.35} />

    <!-- Decorative top flourish -->
    <div class='text-center mb-8'>
      <div class='flex items-center gap-3 text-gold justify-center'>
        <div class='flex-1 h-px bg-gold opacity-25 max-w-20'></div>
        <svg
          width='7'
          height='7'
          viewBox='0 0 10 10'
          fill='currentColor'
          style='opacity:0.5'
        >
          <polygon points='5,0 10,5 5,10 0,5'></polygon>
        </svg>
        <div class='w-2 h-px bg-gold opacity-35'></div>
        <svg width='11' height='11' viewBox='0 0 10 10' fill='currentColor'>
          <polygon points='5,0 10,5 5,10 0,5'></polygon>
        </svg>
        <div class='w-2 h-px bg-gold opacity-35'></div>
        <svg
          width='7'
          height='7'
          viewBox='0 0 10 10'
          fill='currentColor'
          style='opacity:0.5'
        >
          <polygon points='5,0 10,5 5,10 0,5'></polygon>
        </svg>
        <div class='flex-1 h-px bg-gold opacity-25 max-w-20'></div>
      </div>
    </div>

    <p
      class='font-body text-burgundy/70 text-[9px] tracking-[0.6em] uppercase mb-8 text-center'
    >
      Con toda nuestra alegria, los invitamos
    </p>

    <h1
      class='font-display text-burgundy leading-none mb-1 text-center'
      style='font-size: clamp(2.4rem, 9vw, 4.5rem); letter-spacing: 0.06em'
    >
      {COUPLE.groom}
    </h1>
    <p
      class='font-script text-gold text-center my-1'
      style='font-size: clamp(2rem, 7vw, 3.5rem)'
    >
      &amp;
    </p>
    <h1
      class='font-display text-burgundy leading-none mb-8 text-center'
      style='font-size: clamp(2.4rem, 9vw, 4.5rem); letter-spacing: 0.06em'
    >
      {COUPLE.bride}
    </h1>

    <!-- Central divider -->
    <div class='flex items-center gap-3 text-gold justify-center mb-8'>
      <div class='flex-1 h-px bg-gold opacity-25 max-w-20'></div>
      <svg
        width='7'
        height='7'
        viewBox='0 0 10 10'
        fill='currentColor'
        style='opacity:0.5'
      >
        <polygon points='5,0 10,5 5,10 0,5'></polygon>
      </svg>
      <div class='w-2 h-px bg-gold opacity-35'></div>
      <svg width='11' height='11' viewBox='0 0 10 10' fill='currentColor'>
        <polygon points='5,0 10,5 5,10 0,5'></polygon>
      </svg>
      <div class='w-2 h-px bg-gold opacity-35'></div>
      <svg
        width='7'
        height='7'
        viewBox='0 0 10 10'
        fill='currentColor'
        style='opacity:0.5'
      >
        <polygon points='5,0 10,5 5,10 0,5'></polygon>
      </svg>
      <div class='flex-1 h-px bg-gold opacity-25 max-w-20'></div>
    </div>

    <blockquote class='px-2 mb-8 text-center'>
      <p
        class='font-serif text-burgundy/80 italic leading-relaxed'
        style='font-size: clamp(1rem, 3.5vw, 1.2rem)'
      >
        "Y sobre todas estas cosas, vestios de amor, que es el vinculo
        perfecto."
      </p>
      <p
        class='font-body text-burgundy/40 text-[10px] tracking-[0.3em] uppercase mt-3'
      >
        Colosenses 3:14
      </p>
    </blockquote>

    <ThinRule />

    <p
      class='font-display text-gold tracking-[0.35em] text-sm mt-5 uppercase text-center'
    >
      {WEDDING_DATE}
    </p>
  </div>

  <!-- Background image (faint) -->
  <div class='absolute inset-0 z-0'>
    <Image
      src={HERO_IMAGE}
      alt='Pareja de novios'
      class='w-full h-full object-cover'
      style='opacity: 0.08'
      width={896}
      height={1195}
      format='webp'
      loading='eager'
    />
    <div class='absolute inset-0 bg-burgundy/70'></div>
  </div>

  <!-- Discover button -->
  <button
    data-discover
    class='relative z-10 mt-12 flex flex-col items-center gap-2 mx-auto text-cream/40 hover:text-gold transition-colors duration-500 cursor-pointer'
  >
    <span class='font-body text-[9px] tracking-[0.5em] uppercase'
      >Descubrir</span
    >
    <ChevronDownIcon />
  </button>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-discover]');
  button?.addEventListener('click', () => {
    document.getElementById('detalles')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
