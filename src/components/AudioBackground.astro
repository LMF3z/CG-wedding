---
import { AUDIOS } from '../data/wedding';
---

<audio autoplay loop controls id='audio-play' hidden>
  <source src={AUDIOS[0]} type='audio/mp3' />
  Tu navegador no soporta el elemento de audio.
</audio>

<div class='fixed bottom-8 right-8 flex flex-col items-center gap-1 z-50'>
  <p
    id='btn-label'
    class='text-cream/40 text-[8px] tracking-[0.3em] uppercase font-body'
  >
    Play
  </p>

  <button class='wax-seal wax-seal-xs' id='btn-play' type='button'>
    <svg
      id='play-icon'
      xmlns='http://www.w3.org/2000/svg'
      width='20'
      height='20'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
      class='text-burgundy-dark'
    >
      <circle cx='12' cy='12' r='10'></circle>
      <polygon points='10,8 16,12 10,16'></polygon>
    </svg>

    <svg
      id='pause-icon'
      xmlns='http://www.w3.org/2000/svg'
      width='20'
      height='20'
      viewBox='0 0 24 24'
      fill='none'
      stroke='currentColor'
      stroke-width='2'
      stroke-linecap='round'
      stroke-linejoin='round'
      class='text-burgundy-dark hidden'
    >
      <circle cx='12' cy='12' r='10'></circle>
      <rect x='9' y='8' width='2' height='8'></rect>
      <rect x='13' y='8' width='2' height='8'></rect>
    </svg>
  </button>
</div>

<script>
  let play = false;
  const audio = document.getElementById('audio-play') as HTMLAudioElement;
  const btnPlay = document.getElementById('btn-play');

  function playSound() {
    audio
      .play()
      .then(() => {
        play = true;
        document.querySelector('#play-icon')?.classList.add('hidden');
        document.querySelector('#pause-icon')?.classList.remove('hidden');
        document.querySelector('#btn-label')!.innerHTML = 'Pausar';
      })
      .catch((error) => {
        console.log(error);
      });
  }

  window.addEventListener('play:song', () => {
    playSound();
  });

  btnPlay?.addEventListener('click', () => {
    if (play) {
      audio.pause();
      play = false;
      document.querySelector('#play-icon')?.classList.remove('hidden');
      document.querySelector('#pause-icon')?.classList.add('hidden');
      document.querySelector('#btn-label')!.innerHTML = 'Play';
      return;
    }

    playSound();
  });
</script>
